<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DonationAutomate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
  </ItemGroup>

  <!-- Local passwords stay on the development machine; the server uses environment variables. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Local.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Runtime data (spreadsheets, templates, settings) is not part of the app: never build or publish it. -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

</Project>
