<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DonationAutomate</RootNamespace>
  </PropertyGroup>

  <!--
    On Windows, Smart App Control blocks the unsigned DonationAutomate.exe that a build creates, so
    `dotnet run` starts the app through dotnet.exe instead. Publishing for the server (-r linux-x64)
    still produces its executable.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == ''">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
  </ItemGroup>

  <!-- Local passwords stay on the development machine; the server uses environment variables. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Local.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Runtime data (spreadsheets, templates, settings) is not part of the app: never build or publish it. -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

</Project>
