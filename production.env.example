# Production settings: model for /etc/doe-natal.env on the server (environment variables read by
# the doe-natal service). Copy to production.env (git-ignored) to keep a filled-in copy locally.
# Neither this file nor production.env changes the server: after editing /etc/doe-natal.env there,
# run `sudo systemctl restart doe-natal`. See the README (Configuration, Production).

# Runtime
ASPNETCORE_ENVIRONMENT="Production"
ASPNETCORE_URLS="http://127.0.0.1:5000"
DataDirectory="/var/lib/doe-natal/data"
DOTNET_gcServer="0"

# Admin login. The password is not configured here: it is created and reset through a link
# emailed to this address (see the README). A code is also emailed the first time in each browser.
Admin__Email="papainoel@doe-natal.com.br"

# Email sending (Amazon SES, São Paulo)
Smtp__Host="email-smtp.sa-east-1.amazonaws.com"
Smtp__Port="587"
Smtp__User=""
Smtp__Password=""
Smtp__FromName="Natal Solidário - Creche Mundo Infantil"
Smtp__FromAddress="papainoel@doe-natal.com.br"
Smtp__ReplyTo=""

# Donor site
SiteUrl="https://doe-natal.com.br/"
SiteAccessKey=""
