@page
@model IndexModel
@using Microsoft.AspNetCore.Html
@inject IConfiguration Config
@{
    ViewData["Title"] = "Adote um sorriso";
    // The campaign's address (the sender of its emails), for donors who need help.
    var contact = Config["Smtp:FromAddress"];
    var stats = Model.Stats;
    var percent = stats.Total == 0 ? 0 : (int)Math.Round(stats.Chosen * 100.0 / stats.Total);
    var year = DateTime.Now.Year;
}
@functions {
    private static readonly Dictionary<string, string> IconPaths = new()
    {
        ["gift"] = "<rect x='3' y='8' width='18' height='4' rx='1'/><path d='M12 8v13'/><path d='M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7'/><path d='M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5'/>",
        ["search"] = "<circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/>",
        ["check"] = "<path d='M20 6 9 17l-5-5'/>",
        ["heart"] = "<path d='M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z'/>",
        ["mail"] = "<rect x='2' y='4' width='20' height='16' rx='2'/><path d='m22 7-10 6L2 7'/>",
        ["list"] = "<rect x='5' y='3' width='14' height='18' rx='2'/><path d='M9 8h6M9 12h6M9 16h4'/>",
        ["calendar"] = "<rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01'/>",
        ["star"] = "<path d='M12 2.5l2.9 6.1 6.6.7-4.9 4.5 1.4 6.6L12 17.1l-6 3.3 1.4-6.6-4.9-4.5 6.6-.7z'/>",
        ["shoe"] = "<path d='M4 16V7h5l1 3 6 2c2.5.8 4 1.8 4 4v1H4z'/><path d='M4 20h16'/>",
        ["shirt"] = "<path d='M20.4 6.6 16 4a4 4 0 0 1-8 0L3.6 6.6a1 1 0 0 0-.5 1.2l1 3a1 1 0 0 0 1.2.6L7 11v9a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-9l1.7.4a1 1 0 0 0 1.2-.6l1-3a1 1 0 0 0-.5-1.2z'/>",
        ["plus"] = "<path d='M12 5v14M5 12h14'/>",
        ["santa"] = "<path d='M4 17c.5-6.5 4-11 9-11 3.2 0 5.6 2.2 6.4 5.4'/><circle cx='19.6' cy='13.6' r='2'/><rect x='3' y='17' width='17' height='4' rx='2'/>",
        ["arrow"] = "<path d='M5 12h14M13 6l6 6-6 6'/>",
        ["chevron-left"] = "<path d='m15 18-6-6 6-6'/>",
        ["chevron-right"] = "<path d='m9 18 6-6-6-6'/>",
        ["pause"] = "<rect x='6' y='5' width='4' height='14' rx='1'/><rect x='14' y='5' width='4' height='14' rx='1'/>",
        ["play"] = "<path d='M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z'/>",
        ["expand"] = "<path d='M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7'/>",
        ["close"] = "<path d='M18 6 6 18M6 6l12 12'/>",
    };

    /// <summary>A small line icon (decorative; the text next to it carries the meaning).</summary>
    private static IHtmlContent Icon(string name, int size = 20) => new HtmlString(
        $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' " +
        $"stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>{IconPaths[name]}</svg>");
}

@section Hero {
    <section class="hero">
        <div class="hero-bokeh" aria-hidden="true"></div>
        <div class="hero-snow" aria-hidden="true"></div>
        <div class="hero-inner">
            <figure class="hero-photo">
                <img src="~/img/hero-crianca.jpg" alt="Criança sorridente abraçando um presente de Natal" width="422" height="612">
                <figcaption class="note note-photo" aria-hidden="true">Pequenos gestos<br>criam grandes<br>sorrisos! ♡</figcaption>
            </figure>

            <div class="hero-text">
                <h1 class="hero-title">
                    <span class="title-line">Natal</span>
                    <span class="title-line">Solidário</span>
                    <span class="title-year">@year</span>
                </h1>
                <p class="tagline">Adote um sorriso neste Natal!</p>
                <p class="lead">
                    Neste Natal, vamos nos unir para levar alegria, carinho e esperança às crianças da
                    <strong>Creche Comunitária Mundo Infantil</strong>, na comunidade Santa Marta, no Rio de Janeiro.
                </p>
                <div class="hero-actions">
                    <a href="#criancas" class="btn btn-primary btn-lg">@Icon("gift") Escolher uma criança</a>
                    <a href="#como-funciona" class="btn btn-light btn-lg">Como funciona</a>
                </div>

                @* Refreshed in place by live.js, so the numbers follow the spreadsheet. *@
                <div class="hero-card" id="live-progress" data-live>
                    <div class="hero-card-row">
                        <span class="big-number">@stats.Chosen</span>
                        <span>
                            @if (stats.Total > 0 && stats.Available == 0)
                            {
                                <text>de @stats.Total crianças já têm padrinho. Todas foram escolhidas! 🎉</text>
                            }
                            else
                            {
                                <text>de @stats.Total crianças já têm padrinho ou madrinha. Faltam <strong>@stats.Available</strong>.</text>
                            }
                        </span>
                    </div>
                    <div class="garland" role="progressbar" aria-valuemin="0" aria-valuemax="@stats.Total" aria-valuenow="@stats.Chosen"
                         aria-label="@stats.Chosen de @stats.Total crianças já têm padrinho">
                        <div class="garland-fill" style="--fill: @(percent)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@if (Model.ThanksName is not null)
{
    <section class="thanks" id="obrigado" tabindex="-1">
        <div class="thanks-icon">@Icon("gift", 32)</div>
        <h2>Obrigado, @Model.ThanksName! 🎄</h2>
        <p>
            Recebemos a sua escolha de @(Model.ThanksCount == 1 ? "1 criança" : $"{Model.ThanksCount} crianças").
            Falta só um passo: <strong>confirmar pelo link que enviamos para o seu e-mail</strong>.
        </p>
        <p>
            Se o e-mail não aparecer em alguns minutos, confira a caixa de spam ou de promoções.
            @if (!string.IsNullOrWhiteSpace(contact))
            {
                <text>Caso ainda não apareça, escreva para <a href="mailto:@contact">@contact</a>.</text>
            }
        </p>
        <a href="#criancas" class="btn">@Icon("plus", 18) Escolher mais uma criança</a>
    </section>
}

@* ---------------------------------------------------------------- How it works *@
<section class="steps" id="como-funciona" aria-label="Como funciona">
    <div class="step step-red">
        <span class="step-circle">@Icon("list", 40)</span>
        <h3>1. Escolha</h3>
        <p>Uma ou mais crianças e adicione à sacola do Papai Noel.</p>
    </div>
    <div class="step step-green">
        <span class="step-circle">@Icon("mail", 40)</span>
        <h3>2. Confirme</h3>
        <p>Seu nome e e-mail aqui mesmo no site.</p>
    </div>
    <div class="step step-gold">
        <span class="step-circle">@Icon("gift", 40)</span>
        <h3>3. Receba</h3>
        <p>Por e-mail as orientações para montagem e entrega do Kit.</p>
    </div>
    <div class="step step-red">
        <span class="step-circle">@Icon("heart", 40)</span>
        <h3>4. Faça parte</h3>
        <p>Entregue o kit no local informado e tenha um Natal inesquecível!</p>
    </div>
</section>

@* ---------------------------------------------------------------- Kit + calendar *@
<section class="info-row">
    <div class="kit">
        <h2 class="brush-banner">Kit Natal <span aria-hidden="true">♡</span></h2>
        <p class="kit-intro">Cada criança receberá:</p>
        <ul class="kit-items">
            <li>
                <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
                    <path d="M54 14 43 9a11 11 0 0 1-22 0L10 14a3 3 0 0 0-1.6 3.4l2.6 8a3 3 0 0 0 3.4 2L18 27v27a3 3 0 0 0 3 3h22a3 3 0 0 0 3-3V27l3.6.4a3 3 0 0 0 3.4-2l2.6-8A3 3 0 0 0 54 14z" fill="#2f8a5c"/>
                    <path d="M21 9a11 11 0 0 0 22 0" fill="none" stroke="#d23a2f" stroke-width="4"/>
                </svg>
                <span>Roupa</span>
            </li>
            <li>
                <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
                    <path d="M6 44V22h16l4 8 18 5c8 2.2 14 5.6 14 11v4H6z" fill="#d23a2f"/>
                    <path d="M6 50h52v4a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z" fill="#f4ecdd"/>
                    <path d="M24 31l5-4M29 33l5-4M34 35l5-4" stroke="#f4ecdd" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span>Calçado</span>
            </li>
            <li>
                <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
                    <circle cx="18" cy="14" r="7" fill="#c88a3a"/><circle cx="46" cy="14" r="7" fill="#c88a3a"/>
                    <circle cx="18" cy="14" r="3.5" fill="#e9b97a"/><circle cx="46" cy="14" r="3.5" fill="#e9b97a"/>
                    <ellipse cx="32" cy="46" rx="17" ry="15" fill="#c88a3a"/>
                    <circle cx="32" cy="24" r="14" fill="#d79a48"/>
                    <ellipse cx="32" cy="29" rx="6" ry="4.5" fill="#f1cf98"/>
                    <circle cx="27" cy="21" r="1.8" fill="#2b261f"/><circle cx="37" cy="21" r="1.8" fill="#2b261f"/>
                    <circle cx="32" cy="27.5" r="1.8" fill="#2b261f"/>
                    <path d="M25 37l7 3 7-3-2 6-5-2-5 2z" fill="#d23a2f"/>
                </svg>
                <span>Brinquedo</span>
            </li>
        </ul>
    </div>

    <div class="calendar">
        <h2>@Icon("calendar", 26) Calendário @year</h2>
        <p><strong>Entrega dos Kits:</strong> até @IndexModel.FormatDate(Model.SiteSettings.KitsDeadline)</p>
        <p class="calendar-note">O local de entrega dos kits será em Botafogo.</p>
        <p><strong>Festa de Natal na Creche:</strong> @IndexModel.FormatDate(Model.SiteSettings.Festa)</p>
        <p class="calendar-note">Todos os participantes serão convidados para a celebração.</p>
    </div>
</section>

@* ---------------------------------------------------------------- Past Christmases *@
@if (Model.YearPhotos.Count > 0)
{
    var photos = Model.YearPhotos;
    var years = photos.Select(p => p.Year).Distinct().ToList();
    var firstPhotoOf = new Dictionary<int, int>();
    for (var i = 0; i < photos.Count; i++) firstPhotoOf.TryAdd(photos[i].Year, i);
    <section class="memories" id="natais" aria-labelledby="memories-title">
        <div class="memories-head">
            <p class="note">Olha quanta alegria já espalhamos ♡</p>
            <h2 class="section-title" id="memories-title">Natais que fizemos juntos</h2>
            <p class="muted">
                Desde @years[0], padrinhos e madrinhas como você fazem a festa da creche acontecer.
                Cada foto é um Natal, e o próximo pode ter a sua ajuda.
            </p>
        </div>

        <div class="memories-carousel" data-carousel role="region" aria-roledescription="carrossel" aria-label="Fotos dos Natais anteriores">
            <div class="memories-stage" data-stage>
                @for (var i = 0; i < photos.Count; i++)
                {
                    var p = photos[i];
                    <button type="button" class="memory@(i == 0 ? " is-active" : null)" data-year="@p.Year"
                            style="--offset: @i; --abs: @i; z-index: @(100 - i * 10)" tabindex="@(i == 0 ? 0 : -1)"
                            aria-label="Natal @p.Year (foto @(i + 1) de @photos.Count)">
                        <span class="memory-photo">
                            <img src="@p.Src" alt="Festa de Natal da creche em @p.Year" width="600" height="600"
                                 loading="lazy" decoding="async" draggable="false">
                        </span>
                        <span class="memory-caption">Natal <b>@p.Year</b></span>
                        <span class="memory-zoom" aria-hidden="true">@Icon("expand", 14) Ampliar</span>
                    </button>
                }
            </div>

            <div class="memories-controls">
                <button type="button" class="memories-arrow" data-prev aria-label="Natal anterior">@Icon("chevron-left", 22)</button>
                <button type="button" class="memories-play" data-play aria-label="Pausar apresentação" hidden>
                    <svg class="ring" viewBox="0 0 44 44" aria-hidden="true">
                        <circle class="ring-track" cx="22" cy="22" r="20" />
                        <circle class="ring-progress" cx="22" cy="22" r="20" pathLength="100" />
                    </svg>
                    <span class="icon-pause">@Icon("pause", 18)</span>
                    <span class="icon-play">@Icon("play", 18)</span>
                </button>
                <button type="button" class="memories-arrow" data-next aria-label="Próximo Natal">@Icon("chevron-right", 22)</button>
            </div>

            @* A string of Christmas lights: one bulb per year, lit up to the year on show. *@
            <ol class="memories-timeline" style="--n: @years.Count" aria-label="Escolher o ano">
                @for (var y = 0; y < years.Count; y++)
                {
                    <li>
                        <button type="button" class="bulb@(y == 0 ? " is-lit" : null)" data-index="@firstPhotoOf[years[y]]" data-year="@years[y]"
                                aria-label="Natal @years[y]" aria-current="@(y == 0 ? "true" : null)">
                            <span class="bulb-light" aria-hidden="true"></span>
                            <span class="bulb-year">@years[y]</span>
                        </button>
                    </li>
                }
            </ol>

            <p class="visually-hidden" aria-live="polite" data-status></p>
        </div>

        <dialog class="viewer" data-viewer aria-label="Foto ampliada">
            <figure>
                <img data-viewer-img alt="">
                <figcaption data-viewer-caption></figcaption>
            </figure>
            <button type="button" class="viewer-close" data-viewer-close aria-label="Fechar">@Icon("close", 20)</button>
            <button type="button" class="viewer-nav viewer-prev" data-viewer-prev aria-label="Natal anterior">@Icon("chevron-left", 26)</button>
            <button type="button" class="viewer-nav viewer-next" data-viewer-next aria-label="Próximo Natal">@Icon("chevron-right", 26)</button>
        </dialog>
    </section>
}

@* ---------------------------------------------------------------- Children *@
<div class="list-head" id="criancas">
    <div>
        <p class="note">Escolha quem vai receber o seu carinho ♡</p>
        <h2 class="section-title">Crianças esperando um padrinho</h2>
        <p class="muted">Selecione uma ou mais crianças para adotar neste Natal.</p>
    </div>
</div>

@if (Model.Children.Count > 0)
{
    <div class="filter-bar" role="search">
        <label class="search">
            <span class="visually-hidden">Buscar pelo nome</span>
            @Icon("search", 18)
            <input type="search" id="search" placeholder="Buscar pelo nome…" autocomplete="off">
        </label>
        @{
            var byGender = Model.Boys > 0 && Model.Girls > 0;
            var byTurma = Model.Turmas.Count > 1;
        }
        @if (byGender || byTurma)
        {
            @* Gender and turma chips toggle on and off and combine; "Todos" clears both. *@
            <div class="turma-chips" role="group" aria-label="Filtrar crianças">
                <button type="button" class="turma-chip" data-all aria-pressed="true">Todos</button>
                @if (byGender)
                {
                    <button type="button" class="turma-chip" data-gender="@ChildGender.Male" aria-pressed="false">Meninos <span class="count">@Model.Boys</span></button>
                    <button type="button" class="turma-chip" data-gender="@ChildGender.Female" aria-pressed="false">Meninas <span class="count">@Model.Girls</span></button>
                }
                @if (byTurma)
                {
                    @foreach (var (turma, count) in Model.Turmas)
                    {
                        <button type="button" class="turma-chip" data-turma="@turma" aria-pressed="false">@turma <span class="count">@count</span></button>
                    }
                }
            </div>
        }
        <span class="result-count" id="result-count" aria-live="polite"></span>
    </div>
}

<form method="post" id="send-form">
    <span asp-validation-for="Selected" class="field-error"></span>

    @* Refreshed in place by live.js whenever the spreadsheet changes. *@
    <div id="live-list" data-live>
        @if (!Model.HasSpreadsheet)
        {
            <p class="empty">A lista de crianças ainda não foi publicada. Volte em breve! 🎄</p>
        }
        else if (Model.Children.Count == 0)
        {
            <div class="empty">
                <strong>Todas as crianças já têm padrinho ou madrinha!</strong><br>
                Muito obrigado a todos que participaram. 🎉
            </div>
        }
        else
        {
            <div class="child-grid">
                @for (var i = 0; i < Model.Children.Count; i++)
                {
                    var c = Model.Children[i];
                    var meta = string.Join(" · ", new[] { ChildGender.Label(c.Gender), c.Age != "" ? c.Age : c.AgeGroup, c.Turma }.Where(s => s != ""));
                    <label class="child-card" style="--i: @(i % 24)"
                           data-turma="@c.Turma" data-gender="@c.Gender" data-search="@c.Search" data-first="@c.FirstName" data-name="@c.Name"
                           data-initials="@c.Initials" data-color="@c.Color">
                        <input type="checkbox" name="Selected" value="@c.Id" class="visually-hidden"
                               checked="@Model.Selected.Contains(c.Id)" aria-label="Escolher @c.Name">
                        <span class="ribbon" aria-hidden="true">@Icon("check", 18)</span>
                        <span class="child-number">Nº @c.Id</span>
                        <span class="child-top">
                            <span class="avatar" style="--avatar: @c.Color" aria-hidden="true">@c.Initials</span>
                            <span>
                                <span class="child-name">@c.Name</span>
                                <span class="child-meta">@meta</span>
                            </span>
                        </span>
                        @if (c.Shoes != "" || c.Clothes != "")
                        {
                            <span class="sizes">
                                @if (c.Shoes != "")
                                {
                                    <span class="size">@Icon("shoe", 16) Calçado <b>@c.Shoes</b></span>
                                }
                                @if (c.Clothes != "")
                                {
                                    <span class="size">@Icon("shirt", 16) Roupa <b>@c.Clothes</b></span>
                                }
                            </span>
                        }
                        <span class="pick" aria-hidden="true">
                            <span class="when-unchecked">@Icon("santa", 18) Escolher</span>
                            <span class="when-checked">@Icon("check", 16) Na sacola do Papai Noel</span>
                        </span>
                    </label>
                }
            </div>
            <div class="no-results" id="no-results" hidden>
                <p>Nenhuma criança encontrada com esse filtro.</p>
                <button type="button" class="btn" data-clear-filters>Limpar filtros</button>
            </div>
        }
    </div>

    <div class="bag" id="bag" aria-hidden="true" inert>
        <div class="bag-inner">
            <span class="bag-icon" id="bag-icon">@Icon("gift", 24)<span class="bag-count" id="bag-count">0</span></span>
            <div class="bag-text" aria-live="polite">
                <strong id="bag-title">A sacola do Papai Noel está vazia</strong>
                <span id="bag-names"></span>
                <small class="bag-value" id="bag-value"></small>
            </div>
            <button type="button" class="btn btn-ghost" id="bag-clear">Esvaziar</button>
            <button type="button" class="btn btn-primary" id="open-send">Continuar @Icon("arrow", 18)</button>
        </div>
    </div>

    <dialog id="send-dialog" aria-labelledby="send-title" data-open="@(Model.ReopenDialog ? "true" : null)">
        <div class="dialog-head">
            <span class="dialog-icon">@Icon("gift", 24)</span>
            <div>
                <h2 id="send-title">Quase lá!</h2>
                <p class="muted">Confira as crianças e deixe seu contato.</p>
            </div>
        </div>

        <ul class="dialog-children" id="dialog-children" aria-label="Crianças na sacola do Papai Noel"></ul>

        @* The kit is the way to help; the Pix is there for whoever can't buy it, one click away. *@
        <fieldset class="donation-choice">
            <legend>Como você vai ajudar?</legend>
            <p class="donation-intro">
                Cada criança ganha um <strong>kit</strong> com roupa, calçado e brinquedo. Valor médio:
                <strong>R$ @SiteSettingsStore.Money(Model.SiteSettings.PixValue)</strong> por criança<span id="dialog-total"></span>.
            </p>
            <label class="donation-option is-main">
                <input type="radio" name="Donation" value="@ChildDonation.Kit" checked="@(Model.Donation != ChildDonation.Pix)">
                <span>
                    <strong>@Icon("gift", 18) Vou comprar o kit <em class="tag">recomendado</em></strong>
                    <small>Você escolhe e compra o presente e entrega até @MailService.Deadline(Model.SiteSettings). É a parte mais especial da campanha!</small>
                </span>
            </label>
            <details class="pix-alt" open="@(Model.Donation == ChildDonation.Pix)">
                <summary>Não consegue comprar o kit?</summary>
                <label class="donation-option">
                    <input type="radio" name="Donation" value="@ChildDonation.Pix" checked="@(Model.Donation == ChildDonation.Pix)">
                    <span>
                        <strong>Doar via Pix</strong>
                        <small>A equipe compra o kit por você. Valor médio de R$ @SiteSettingsStore.Money(Model.SiteSettings.PixValue) por criança, até @MailService.Deadline(Model.SiteSettings).</small>
                    </span>
                </label>
            </details>
            <span asp-validation-for="Donation" class="field-error"></span>
        </fieldset>

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" required autocomplete="name" placeholder="Como podemos te chamar?">
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" required autocomplete="email" placeholder="voce@exemplo.com">
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="EmailConfirmation"></label>
            <input asp-for="EmailConfirmation" type="email" required autocomplete="off" placeholder="Digite o e-mail de novo">
            <span asp-validation-for="EmailConfirmation" class="field-error"></span>
        </div>

        <div class="actions">
            <button type="button" class="btn btn-ghost" id="cancel-send">Voltar</button>
            <button type="submit" class="btn btn-primary" id="confirm-send">@Icon("gift", 18) Confirmar apadrinhamento</button>
        </div>
        <p class="privacy">Usamos seu contato só para falar sobre esta campanha de Natal.</p>
    </dialog>
</form>

@* ---------------------------------------------------------------- More than a gift *@
<section class="info-row closing">
    <div class="more">
        <span class="more-star" aria-hidden="true">@Icon("star", 34)</span>
        <h2 class="section-title red">Mais que um presente</h2>
        <p>
            Seu gesto ajuda a construir lembranças, fortalecer sonhos e levar o verdadeiro espírito do Natal
            para dezenas de crianças atendidas pela <strong>Creche Comunitária Mundo Infantil</strong>.
        </p>
    </div>
    <div class="quote">
        <p class="note quote-text">“Porque toda criança merece viver a magia do Natal.”</p>
        @Html.Raw(SantaMartaIllustration.Svg)
        <p class="note skyline-label">Santa Marta<br>Rio de Janeiro</p>
    </div>
</section>

<div class="page-bottom-space"></div>

@section Scripts {
    <script src="~/js/memories.js" asp-append-version="true"></script>
    <script>
        (() => {
            const form = document.getElementById('send-form');
            const dialog = document.getElementById('send-dialog');
            const bag = document.getElementById('bag');
            const search = document.getElementById('search');
            const fold = s => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
            let turma = '';
            let gender = '';

            // Average cost of a kit (and suggested Pix) per child, from the campaign settings.
            const kitValue = @Model.SiteSettings.PixValue;
            const money = n => `R$ ${n.toLocaleString('pt-BR')}`;

            // Cards live inside #live-list, which is replaced on refresh: always look them up fresh.
            const boxes = () => [...form.querySelectorAll('input[name="Selected"]')];
            const cardOf = box => box.closest('.child-card');
            const chosen = () => boxes().filter(b => b.checked);

            function updateBag(bump) {
                const cards = chosen().map(cardOf);
                const n = cards.length;
                bag.classList.toggle('open', n > 0);
                bag.inert = n === 0;
                bag.setAttribute('aria-hidden', String(n === 0));
                document.getElementById('bag-count').textContent = n;
                document.getElementById('bag-title').textContent =
                    n === 0 ? 'A sacola do Papai Noel está vazia' : n === 1 ? '1 criança na sacola do Papai Noel' : `${n} crianças na sacola do Papai Noel`;
                const names = cards.map(c => c.dataset.first);
                document.getElementById('bag-names').textContent = names.length > 3
                    ? `${names.slice(0, 3).join(', ')} e mais ${names.length - 3}`
                    : names.join(', ');
                document.getElementById('bag-value').textContent = n === 0 ? ''
                    : `Kits em média ${money(kitValue)};
                if (bump) Festive.replay(document.getElementById('bag-icon'), 'bump');
            }

            function applyFilters() {
                const q = fold(search?.value ?? '');
                const all = boxes();
                let visible = 0;
                for (const box of all) {
                    const card = cardOf(box);
                    const show = (!turma || card.dataset.turma === turma) && (!gender || card.dataset.gender === gender)
                        && (!q || card.dataset.search.includes(q));
                    card.hidden = !show;
                    if (show) visible++;
                }
                const none = document.getElementById('no-results');
                if (none) none.hidden = visible > 0 || all.length === 0;
                const count = document.getElementById('result-count');
                if (count) count.textContent = all.length === 0 ? ''
                    : visible === all.length ? `${all.length} crianças` : `${visible} de ${all.length} crianças`;
            }

            function syncChips() {
                document.querySelectorAll('.turma-chip[data-gender]').forEach(c => c.setAttribute('aria-pressed', String(c.dataset.gender === gender)));
                document.querySelectorAll('.turma-chip[data-turma]').forEach(c => c.setAttribute('aria-pressed', String(c.dataset.turma === turma)));
                document.querySelector('.turma-chip[data-all]')?.setAttribute('aria-pressed', String(!gender && !turma));
                applyFilters();
            }

            // Clicking the active chip again turns that filter off.
            function setGender(value) {
                gender = gender === value ? '' : value;
                syncChips();
            }

            function setTurma(value) {
                turma = turma === value ? '' : value;
                syncChips();
            }

            function clearChips() {
                gender = '';
                turma = '';
                syncChips();
            }

            form.addEventListener('change', e => {
                if (e.target.name !== 'Selected') return;
                if (e.target.checked) Festive.replay(cardOf(e.target), 'pop');
                updateBag(true);
            });

            search?.addEventListener('input', applyFilters);
            document.querySelectorAll('.turma-chip[data-turma]').forEach(chip => chip.addEventListener('click', () => setTurma(chip.dataset.turma)));
            document.querySelectorAll('.turma-chip[data-gender]').forEach(chip => chip.addEventListener('click', () => setGender(chip.dataset.gender)));
            document.querySelector('.turma-chip[data-all]')?.addEventListener('click', clearChips);
            document.addEventListener('click', e => {
                if (!e.target.closest('[data-clear-filters]')) return;
                if (search) search.value = '';
                clearChips();
            });

            document.getElementById('bag-clear').addEventListener('click', () => {
                chosen().forEach(b => b.checked = false);
                updateBag();
            });

            // The dialog lists who is in the bag, each with a button to take them out.
            function showTotal() {
                const n = chosen().length;
                document.getElementById('dialog-total').textContent =
                    n > 1 ? ` (${n} crianças ≈ ${money(n * kitValue)})` : '';
            }

            function fillDialog() {
                showTotal();
                const list = document.getElementById('dialog-children');
                list.replaceChildren(...chosen().map(box => {
                    const card = cardOf(box);
                    const li = document.createElement('li');
                    const avatar = document.createElement('span');
                    avatar.className = 'avatar';
                    avatar.style.setProperty('--avatar', card.dataset.color);
                    avatar.textContent = card.dataset.initials;
                    const info = document.createElement('span');
                    info.className = 'info';
                    info.textContent = card.dataset.name;
                    const meta = document.createElement('small');
                    meta.textContent = card.querySelector('.child-meta').textContent;
                    info.append(meta);
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'btn-icon';
                    remove.textContent = '✕';
                    remove.title = `Tirar ${card.dataset.first} da sacola do Papai Noel`;
                    remove.setAttribute('aria-label', remove.title);
                    remove.addEventListener('click', () => {
                        box.checked = false;
                        li.remove();
                        updateBag();
                        showTotal();
                        if (!list.children.length) dialog.close();
                    });
                    li.append(avatar, info, remove);
                    return li;
                }));
            }

            function openDialog() {
                fillDialog();
                dialog.showModal();
                const name = dialog.querySelector('input[name="Name"]');
                (name.value ? dialog.querySelector('#confirm-send') : name).focus();
            }

            document.getElementById('open-send').addEventListener('click', openDialog);
            document.getElementById('cancel-send').addEventListener('click', () => dialog.close());

            // The email typed twice must be identical, character for character; the browser blocks sending until it is.
            const email = form.querySelector('input[name="Email"]');
            const emailAgain = form.querySelector('input[name="EmailConfirmation"]');
            function checkEmails() {
                const same = email.value === emailAgain.value;
                emailAgain.setCustomValidity(!emailAgain.value || same ? '' : 'Os dois e-mails não são iguais. Confira se não há erro de digitação.');
            }
            email.addEventListener('input', checkEmails);
            emailAgain.addEventListener('input', checkEmails);
            emailAgain.addEventListener('blur', () => { checkEmails(); emailAgain.reportValidity(); });

            form.addEventListener('submit', e => {
                if (chosen().length === 0) { e.preventDefault(); dialog.close(); return; }
                const btn = document.getElementById('confirm-send');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner" aria-hidden="true"></span> Enviando…';
            });

            // Keep the bag across refreshes. Children someone else just chose disappear from the
            // list, and from the bag with them.
            let ticked = [];
            Live.start({
                canSwap: () => !dialog.open,
                beforeSwap: () => { ticked = chosen().map(b => b.value); },
                afterSwap: () => {
                    document.querySelector('.child-grid')?.classList.add('settled');
                    boxes().forEach(b => b.checked = ticked.includes(b.value));
                    applyFilters();
                    updateBag();
                },
            });

            // Let the string of lights fill up on arrival.
            const fill = document.querySelector('.garland-fill');
            if (fill && !Festive.reducedMotion()) {
                const target = fill.style.getPropertyValue('--fill');
                fill.style.setProperty('--fill', '0%');
                requestAnimationFrame(() => requestAnimationFrame(() => fill.style.setProperty('--fill', target)));
            }

            applyFilters();
            updateBag();

            const thanks = document.getElementById('obrigado');
            if (thanks) {
                thanks.focus({ preventScroll: true });
                Festive.confetti();
            }
            if (dialog.dataset.open) openDialog();
        })();
    </script>
}
