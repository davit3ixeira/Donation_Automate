@model SheetCard
@*
    One spreadsheet on the admin page: the copy uploaded through the site, which the system keeps
    up to date and the admin can download.
*@
<div class="card">
    <h2>@Model.Title</h2>
    <div id="@Model.MetaId" data-live>
        <p class="muted">
            @if (Model.Data.IsEmpty)
            {
                <text>Nenhuma planilha ainda.</text>
            }
            else
            {
                <text>@Model.Data.Rows.Count linhas · atualizada em @Model.Data.LastModified?.ToString("dd/MM/yyyy HH:mm:ss")</text>
            }
        </p>
    </div>

    <form method="post" asp-page-handler="@("Upload" + Model.Handler)" enctype="multipart/form-data" class="upload"
          onsubmit="@(Model.ConfirmReplace && !Model.Data.IsEmpty ? "return confirm('Enviar uma nova planilha substitui todos os dados atuais, inclusive as alterações feitas pelo site. Continuar?')" : null)">
        @* No accept filter: phones often grey out Google Drive files with it. The server checks the content. *@
        <input type="file" name="file" required>
        <button class="btn btn-primary">Enviar</button>
    </form>
    <p class="hint muted">
        Aceita Excel (.xlsx) e Google Sheets (baixado como Excel ou CSV).
        As alterações feitas pelo site são gravadas nesta planilha.
        @if (!Model.Data.IsEmpty)
        {
            <text>Para ter a versão atualizada no computador, use <em>Baixar planilha atual</em>.</text>
        }
    </p>
    @if (!Model.Data.IsEmpty)
    {
        <a class="link" asp-page-handler="@("Download" + Model.Handler)">Baixar planilha atual</a>
    }

    @if (Model.Columns is not null)
    {
        <p class="hint muted columns">Colunas, nesta ordem (os nomes podem variar): @Model.Columns</p>
    }
</div>
