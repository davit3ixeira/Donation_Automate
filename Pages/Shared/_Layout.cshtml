@inject IConfiguration Config
@{
    var page = ViewContext.RouteData.Values["page"] as string;
    // The campaign's address (the sender of its emails), shown in the footer.
    var contactEmail = Config["Smtp:FromAddress"];
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1f17">
    <title>@ViewData["Title"] · Natal Solidário @DateTime.Now.Year</title>
    <link rel="icon" type="image/svg+xml" href="~/img/icone-favicon.svg" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/img/icone-512.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Caveat:wght@500;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800;6..12,900&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-page="/Index">
                <img class="brand-mark" src="~/img/icone.svg" asp-append-version="true" width="42" height="42" alt="">

                <span class="brand-text">
                    <span class="brand-title">Natal Solidário <em>@DateTime.Now.Year</em></span>
                    <small>Creche Mundo Infantil · Santa Marta</small>
                </span>
            </a>
            <nav aria-label="Navegação principal">
                <a asp-page="/Index" class="@(page == "/Index" ? "active" : null)">Doações</a>
                <span class="nav-sep" aria-hidden="true"></span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-team">Equipe</span>
                    <a asp-page="/Admin" class="@(page == "/Admin" ? "active" : null)">Administração</a>
                    <a asp-page="/Emails" class="@(page == "/Emails" ? "active" : null)">E-mails</a>
                    <a asp-page="/Logout">Sair</a>
                }
                else
                {
                    <a asp-page="/Login">Equipe</a>
                }
            </nav>
        </div>
    </header>

    @await RenderSectionAsync("Hero", required: false)

    <main class="container" data-sheet-version="@ViewData["SheetVersion"]">
        @if (TempData["Message"] is string message)
        {
            <div class="flash flash-ok" role="status">@message</div>
        }
        @if ((TempData["Error"] ?? ViewData["Error"]) is string error)
        {
            <div class="flash flash-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-logo">
                <img src="~/img/icone.svg" asp-append-version="true" width="58" height="58" alt="">

                <span>Creche Comunitária<strong>Mundo Infantil</strong></span>
            </div>
            <address>
                <strong>Obras Sociais Unidas de Santa Marta</strong>
                Rua do Jabuti nº 9 (3ª parada do plano inclinado)<br>
                Botafogo · Santa Marta · Rio de Janeiro<br>
                @if (!string.IsNullOrWhiteSpace(contactEmail))
                {
                    @* "Copiar" too: the mailto link depends on a mail app being set up on the device. *@
                    <a href="mailto:@contactEmail">@contactEmail</a>
                    <button type="button" class="copy-email" data-copy="@contactEmail">copiar</button><br>
                }
            </address>
            <p class="footer-script">Juntos por um Natal<br>mais feliz! ♡</p>
        </div>
    </footer>

    <script src="~/js/live.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // "Copiar" next to an address: to paste into any webmail when the device has no mail app set up.
        document.addEventListener('click', async e => {
            const btn = e.target.closest?.('[data-copy]');
            if (!btn) return;
            try {
                await navigator.clipboard.writeText(btn.dataset.copy);
                btn.textContent = 'copiado!';
            } catch {
                prompt('Copie o e-mail:', btn.dataset.copy);  // no clipboard access (e.g. outside HTTPS)
            }
            setTimeout(() => btn.textContent = 'copiar', 2000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
