@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Área da equipe</p>
        <h1>Entrar</h1>
        <p class="muted">Informe o e-mail e a senha para acessar a administração e os e-mails.</p>
    </div>
</div>

<section class="cards">
    <div class="card">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Usuario"></label>
                <input asp-for="Usuario" type="email" required autocomplete="username" autofocus>
                <span asp-validation-for="Usuario" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" type="password" required autocomplete="current-password">
                <span asp-validation-for="Senha" class="field-error"></span>
            </div>
            <div class="actions">
                <button type="submit" class="btn btn-primary">Entrar</button>
            </div>
        </form>
    </div>
</section>
