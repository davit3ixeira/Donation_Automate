@page
@model ConfirmarModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Confirmar apadrinhamento";
    var greeting = Model.DonorName != "" ? $"{Model.DonorName.Split(' ')[0]}, " : "";
    var contact = Config["Smtp:FromAddress"];
}

<div class="page-head">
    <div>
        <p class="eyebrow">Natal Solidário</p>
        @switch (Model.Status)
        {
            case ConfirmarModel.State.Pending:
                <h1>Confirme sua escolha</h1>
                <p class="muted">@(greeting)você vai apadrinhar:</p>
                break;
            case ConfirmarModel.State.Done:
                <h1>Escolha confirmada! 🎄</h1>
                <p class="muted">Muito obrigado, @(greeting)de coração. Enviamos para o seu e-mail as instruções de entrega e o prazo. Se não encontrar, confira a caixa de spam.</p>
                break;
            case ConfirmarModel.State.AlreadyConfirmed:
                <h1>Escolha já confirmada</h1>
                <p class="muted">Está tudo certo, @(greeting)a sua escolha já tinha sido confirmada. As instruções de entrega estão no seu e-mail.</p>
                break;
            case ConfirmarModel.State.Unavailable:
                <h1>Pedido não encontrado</h1>
                <p class="muted">Estas crianças não estão mais reservadas para você. Se achar que é um engano, responda o e-mail que recebemos de você.</p>
                break;
            default:
                <h1>Link inválido</h1>
                <p class="muted">Este link de confirmação não é válido ou expirou. Responda o e-mail que você recebeu e a equipe ajuda.</p>
                break;
        }
    </div>
</div>

@if (Model.Children.Count > 0 && Model.Status is ConfirmarModel.State.Pending or ConfirmarModel.State.Done or ConfirmarModel.State.AlreadyConfirmed)
{
    <section class="confirm-section">
        <div class="confirm-grid">
            @foreach (var c in Model.Children)
            {
                <article class="card confirm-child">
                    <header>
                        <span class="confirm-number">Nº @c.Id</span>
                        <h2>🎁 @c.Name</h2>
                    </header>
                    <dl>
                        @if (c.Gender != "") { <dt>Gênero</dt><dd>@c.Gender</dd> }
                        @if (c.Turma != "") { <dt>Turma</dt><dd>@c.Turma</dd> }
                        @if (c.AgeGroup != "") { <dt>Faixa etária</dt><dd>@c.AgeGroup</dd> }
                        @if (c.Age != "") { <dt>Idade</dt><dd>@c.Age</dd> }
                        @if (c.Shoes != "") { <dt>Calçado</dt><dd>@c.Shoes</dd> }
                        @if (c.Clothes != "") { <dt>Roupa</dt><dd>@c.Clothes</dd> }
                        @if (c.Donation != "")
                        {
                            <dt>Doação</dt>
                            <dd>@(c.Donation == ChildDonation.Kit ? "Kit (roupa, calçado e brinquedo)" : "Pix")</dd>
                        }
                    </dl>
                </article>
            }
        </div>
        @if (Model.Warning is not null || Model.Status == ConfirmarModel.State.Pending)
        {
            <div class="card confirm-actions">
                @if (Model.Warning is not null)
                {
                    <p class="field-error">@Model.Warning</p>
                }
                @if (Model.Status == ConfirmarModel.State.Pending)
                {
                    <p class="muted">
                        Confira os dados de @(Model.Children.Count == 1 ? "da criança" : "cada criança") acima.
                        Ao confirmar, você recebe por e-mail as instruções de entrega e o prazo.
                        @if (!string.IsNullOrWhiteSpace(contact))
                        {
                            <text>Caso haja algum imprevisto escreva para <a href="mailto:@contact">@contact</a></text>
                        }
                    </p>
                    <form method="post">
                        <input type="hidden" name="token" value="@Model.Token">
                        <div class="actions">
                            <button class="btn btn-primary btn-lg">Confirmar</button>
                        </div>
                    </form>
                }
            </div>
        }
    </section>
}
