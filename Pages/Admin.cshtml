@page
@model AdminModel
@{
    ViewData["Title"] = "Administração";
}

@Html.AntiForgeryToken()

<div class="page-head with-actions">
    <div>
        <p class="eyebrow">Área da equipe</p>
        <h1>Administração</h1>
        <p class="muted">Edite as crianças direto na tabela abaixo. Cada alteração é gravada na planilha na hora, e alterações na planilha aparecem aqui automaticamente.</p>
    </div>
    <div class="sync">
        <span id="sync-stamp" class="muted" aria-live="polite"></span>
    </div>
</div>

<section class="cards">
    <div class="card">
        <h2>Configurações da campanha</h2>
        <p class="muted">Datas do bloco "Calendário" da página inicial, valor médio do kit e como os padrinhos entregam a doação. Usados no site e nos e-mails.</p>
        <form method="post" asp-page-handler="SiteSettings">
            <div class="field">
                <label for="kitsDeadline">Entrega dos Kits e Pix (até)</label>
                <input type="date" id="kitsDeadline" name="kitsDeadline" value="@Model.SiteSettings.KitsDeadline.ToString("yyyy-MM-dd")" required>
            </div>
            <div class="field">
                <label for="festa">Festa de Natal na Creche</label>
                <input type="date" id="festa" name="festa" value="@Model.SiteSettings.Festa.ToString("yyyy-MM-dd")" required>
            </div>
            <div class="field">
                <label for="pixValue">Valor médio de um kit / Pix por criança (R$)</label>
                <input type="number" id="pixValue" name="pixValue" min="1" step="1" value="@Model.SiteSettings.PixValue" required>
            </div>
            <div class="field">
                <label for="deliveryAddress">Endereço de entrega dos kits</label>
                <input id="deliveryAddress" name="deliveryAddress" value="@Model.SiteSettings.DeliveryAddress" placeholder="Rua, número, apartamento, aos cuidados de…">
            </div>
            <div class="field">
                <label for="pixKey">Chave Pix</label>
                <input id="pixKey" name="pixKey" value="@Model.SiteSettings.PixKey" autocomplete="off">
            </div>
            <button class="btn btn-primary">Salvar configurações</button>
        </form>
    </div>
    <partial name="_SheetCard" model="Model.ChildrenCard" />
</section>

@* Refreshed in place by live.js whenever the spreadsheet changes. *@
<div id="live-children" data-live>
    @if (!Model.Children.IsEmpty)
    {
        // System columns shown as controls at the start of the row, not as text.
        var doneColumn = Model.Children.DoneColumn;
        var donationColumn = Model.Children.DonationColumn;
        var sentColumn = Model.Children.ConfirmationSentColumn;
        <section id="tabela">
            <div class="section-head">
                <h2>
                    Doar
                    @if (Model.Counts[ChildStatus.Approved] > 0)
                    {
                        <span class="kit-summary">🎁 @Model.DoneCount de @Model.Counts[ChildStatus.Approved] realizados</span>
                    }
                </h2>
                <div class="section-actions">
                    @* Exports what the table shows: the filtered rows, or everything without filters. *@
                    <a class="btn" asp-page-handler="DownloadChildren" asp-all-route-data="Model.FilterRoute()"
                       title="@(Model.IsFiltered ? "Baixa só as crianças que os filtros estão mostrando" : "Baixa a planilha completa")">
                        ⬇ @(Model.IsFiltered ? $"Exportar filtradas ({Model.FilteredRows.Count})" : "Exportar planilha")
                    </a>
                    <form method="post" asp-page-handler="AddRow">
                        <button class="btn btn-primary">+ Adicionar criança</button>
                    </form>
                </div>
            </div>
            <div class="filter-rows">
                <nav class="filters" aria-label="Filtrar por status">
                    <a asp-all-route-data="Model.FilterRoute(filter: string.Empty)" class="@(string.IsNullOrEmpty(Model.Filter) ? "active" : null)">
                        Todas <span class="count">@Model.Children.Rows.Count</span>
                    </a>
                    @foreach (var s in ChildStatus.All)
                    {
                        <a asp-all-route-data="Model.FilterRoute(filter: ChildStatus.CssClass(s))" class="@(Model.Filter == ChildStatus.CssClass(s) ? "active" : null)">
                            @ChildStatus.Label(s) <span class="count">@Model.Counts[s]</span>
                        </a>
                    }
                </nav>
                <nav class="filters" aria-label="Filtrar por doação">
                    <span class="filters-label">Doação</span>
                    <a asp-all-route-data="Model.FilterRoute(doacao: string.Empty)" class="@(string.IsNullOrEmpty(Model.Doacao) ? "active" : null)">Todas</a>
                    @foreach (var d in ChildDonation.All)
                    {
                        <a asp-all-route-data="Model.FilterRoute(doacao: d.ToLowerInvariant())" class="@(ChildDonation.Of(Model.Doacao) == d ? "active" : null)">
                            @d <span class="count">@Model.DonationCount(d)</span>
                        </a>
                    }
                </nav>
                <nav class="filters" aria-label="Filtrar por realizado">
                    <span class="filters-label">Realizado</span>
                    <a asp-all-route-data="Model.FilterRoute(realizado: string.Empty)" class="@(string.IsNullOrEmpty(Model.Realizado) ? "active" : null)">Todos</a>
                    <a asp-all-route-data='Model.FilterRoute(realizado: "sim")' class="@(Model.Realizado == "sim" ? "active" : null)">
                        Sim <span class="count">@Model.DoneCount</span>
                    </a>
                    <a asp-all-route-data='Model.FilterRoute(realizado: "nao")' class="@(Model.Realizado == "nao" ? "active" : null)">
                        Não <span class="count">@(Model.Counts[ChildStatus.Approved] - Model.DoneCount)</span>
                    </a>
                </nav>
            </div>

            @if (Model.FilteredRows.Count == 0)
            {
                <p class="empty">Nenhuma criança com estes filtros.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data grid" id="children-grid">
                        <thead>
                            <tr>
                                <th>Realizado</th>
                                <th>Doação</th>
                                @for (var i = 0; i < Model.Children.Headers.Count; i++)
                                {
                                    if (i == doneColumn || i == donationColumn || i == sentColumn) continue;
                                    <th>@Model.Children.Headers[i]</th>
                                }
                                <th><span class="visually-hidden">Ações</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.FilteredRows)
                            {
                                var current = AdminModel.StatusOf(row);
                                var editable = row.Key != "";
                                var donation = Model.Children.Donation(row);
                                <tr id="@(editable ? $"row-{row.Key}" : null)" data-id="@row.Key">
                                    <td class="kit-cell">
                                        @if (editable && current == ChildStatus.Approved)
                                        {
                                            <label class="kit-toggle">
                                                <input type="checkbox" class="done-check" data-id="@row.Key"
                                                       checked="@Model.Children.Done(row)" aria-label="Doação da criança nº @row.Key realizada">
                                                <span class="kit-switch" aria-hidden="true"></span>
                                            </label>
                                        }
                                        else
                                        {
                                            <span class="muted" title="Só para pedidos aprovados">–</span>
                                        }
                                    </td>
                                    <td>
                                        @if (editable && AdminModel.HasDonor(row))
                                        {
                                            <select class="donation-select" data-id="@row.Key" aria-label="Doação da criança nº @row.Key">
                                                @if (donation == "")
                                                {
                                                    <option value="" selected disabled>–</option>
                                                }
                                                @foreach (var d in ChildDonation.All)
                                                {
                                                    <option value="@d" selected="@(d == donation)">@d</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="muted">–</span>
                                        }
                                    </td>
                                    @for (var i = 0; i < Model.Children.Headers.Count; i++)
                                    {
                                        if (i == doneColumn || i == donationColumn || i == sentColumn) continue;
                                        if (i != ChildColumns.Status || !editable)
                                        {
                                            if (editable)
                                            {
                                                <td class="cell" contenteditable="plaintext-only" spellcheck="false" data-col="@i">@row.Values[i]</td>
                                            }
                                            else
                                            {
                                                <td>@row.Values[i]</td>
                                            }
                                            continue;
                                        }
                                        <td>
                                            <div class="status-cell">
                                                <form method="post" asp-page-handler="Status" asp-all-route-data="Model.FilterRoute()">
                                                    <input type="hidden" name="id" value="@row.Key">
                                                    <select name="status" class="status status-@ChildStatus.CssClass(current)" aria-label="Status">
                                                        @if (!ChildStatus.All.Contains(current))
                                                        {
                                                            <option selected disabled>@current</option>
                                                        }
                                                        @foreach (var s in ChildStatus.All)
                                                        {
                                                            <option value="@ChildStatus.CssClass(s)" selected="@(s == current)">@ChildStatus.Label(s)</option>
                                                        }
                                                    </select>
                                                    <noscript><button class="btn btn-small">Salvar</button></noscript>
                                                </form>
                                                @if (current == ChildStatus.Pending && !Model.Children.ConfirmationSent(row))
                                                {
                                                    <form method="post" asp-page-handler="SendConfirmation" asp-all-route-data="Model.FilterRoute()" class="flow-form">
                                                        <input type="hidden" name="id" value="@row.Key">
                                                        <button class="btn btn-small btn-approve" title="Envia ao padrinho o e-mail com o link para confirmar (todas as crianças pendentes dele)">Enviar e-mail de confirmação</button>
                                                    </form>
                                                }
                                                else if (current == ChildStatus.Pending)
                                                {
                                                    <form method="post" asp-page-handler="Confirm" asp-all-route-data="Model.FilterRoute()" class="flow-form confirm-form">
                                                        <input type="hidden" name="id" value="@row.Key">
                                                        <button class="btn btn-small btn-approve" title="Confirma pelo padrinho (todas as crianças pendentes dele) e envia as instruções de entrega">Confirmar</button>
                                                    </form>
                                                    <form method="post" asp-page-handler="SendConfirmation" asp-all-route-data="Model.FilterRoute()" class="flow-form">
                                                        <input type="hidden" name="id" value="@row.Key">
                                                        <button class="btn-text" title="Envia de novo o e-mail com o link de confirmação">reenviar e-mail</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    }
                                    <td class="row-actions">
                                        @if (editable)
                                        {
                                            <form method="post" asp-page-handler="DeleteRow" asp-all-route-data="Model.FilterRoute()" class="delete-form">
                                                <input type="hidden" name="id" value="@row.Key">
                                                <button class="btn-icon" title="Excluir criança" aria-label="Excluir criança nº @row.Key">✕</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>


<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

@section Scripts {
    <script>
        (() => {
            const ID_COL = @ChildColumns.Id;
            const NAME_COL = @ChildColumns.Nome;
            const STATUS_COL = @ChildColumns.Status;
            const main = document.querySelector('main');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const syncBtn = document.getElementById('sync');
            const stamp = document.getElementById('sync-stamp');
            const toastEl = document.getElementById('toast');
            const now = () => new Date().toLocaleTimeString('pt-BR');
            let saving = 0;
            let toastTimer;

            function toast(message, kind = 'ok') {
                toastEl.textContent = message;
                toastEl.className = `toast toast-${kind}`;
                toastEl.hidden = false;
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => toastEl.hidden = true, kind === 'error' ? 6000 : 2500);
            }

            // Saves one cell. The server answers with the value as stored and the spreadsheet's
            // new version, which we record so live.js doesn't reload the table for our own edit.
            async function saveCell(id, column, value) {
                saving++;
                try {
                    const res = await fetch('?handler=Cell', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: new URLSearchParams({ id, column, value }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || data.error) throw new Error(data.error || 'Não foi possível salvar. Tente novamente.');
                    main.dataset.sheetVersion = data.version;
                    return data;
                } finally {
                    saving--;
                }
            }

            const cellOf = target => target.closest?.('#children-grid td.cell');

            // Editable cells: remember the value on focus, save on blur if it changed.
            document.addEventListener('focusin', e => {
                const td = cellOf(e.target);
                if (td) td.dataset.original = td.textContent;
            });

            document.addEventListener('keydown', e => {
                const td = cellOf(e.target);
                if (!td) return;
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); td.blur(); }
                if (e.key === 'Escape') { td.textContent = td.dataset.original ?? ''; td.blur(); }
            });

            document.addEventListener('focusout', async e => {
                const td = cellOf(e.target);
                if (!td) return;
                const value = td.textContent.trim();
                const original = (td.dataset.original ?? '').trim();
                if (value === original) { td.textContent = td.dataset.original ?? ''; return; }

                const tr = td.closest('tr');
                td.classList.remove('error', 'saved');
                td.classList.add('saving');
                td.removeAttribute('title');
                try {
                    const data = await saveCell(tr.dataset.id, td.dataset.col, value);
                    td.textContent = data.value;
                    if (Number(td.dataset.col) === ID_COL) {
                        tr.dataset.id = data.value;
                        tr.id = `row-${data.value}`;
                        tr.querySelectorAll('input[name="id"]').forEach(i => i.value = data.value);
                    }
                    td.classList.add('saved');
                } catch (err) {
                    td.textContent = td.dataset.original ?? '';
                    td.classList.add('error');
                    td.title = err.message;
                    toast(err.message, 'error');
                } finally {
                    td.classList.remove('saving');
                }
            });

            async function changeStatus(tr, status) {
                try {
                    const data = await saveCell(tr.dataset.id, STATUS_COL, status);
                    if (data.warning) toast(`${data.message} ${data.warning}`, 'error');
                    else toast(data.message);
                    await Live.refresh();  // counts, filters and the sponsor columns may have changed
                } catch (err) {
                    toast(err.message, 'error');
                    await Live.refresh();
                }
            }

            document.addEventListener('change', e => {
                const select = e.target.closest?.('#children-grid select[name="status"]');
                if (select) changeStatus(select.closest('tr'), select.value);
            });

            // Posts one of the row controls (done switch, donation list) and refreshes the counts.
            async function saveControl(handler, params) {
                saving++;
                try {
                    const res = await fetch(`?handler=${handler}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: new URLSearchParams(params),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || data.error) throw new Error(data.error || 'Não foi possível salvar. Tente novamente.');
                    main.dataset.sheetVersion = data.version;
                    toast(data.message);
                    await Live.refresh();  // updates the counts and filters
                } finally {
                    saving--;
                }
            }

            // "Realizado": saved as soon as it's switched; put back if the save fails.
            document.addEventListener('change', async e => {
                const box = e.target.closest?.('#children-grid .done-check');
                if (!box) return;
                box.disabled = true;
                try {
                    await saveControl('Done', { id: box.dataset.id, done: box.checked });
                    if (box.checked) Festive.replay(box.closest('.kit-toggle'), 'pop');
                } catch (err) {
                    box.checked = !box.checked;
                    toast(err.message, 'error');
                } finally {
                    box.disabled = false;
                    box.blur();
                }
            });

            // "Doação": Kit or Pix, saved as soon as it's chosen.
            document.addEventListener('change', async e => {
                const select = e.target.closest?.('#children-grid .donation-select');
                if (!select) return;
                try {
                    await saveControl('Donation', { id: select.dataset.id, value: select.value });
                } catch (err) {
                    toast(err.message, 'error');
                    await Live.refresh();
                }
            });

            // Filters swap the table in place instead of loading a new page, so the screen stays put
            // (phones especially). The address follows, so reloading or "back" keeps the filter.
            document.addEventListener('click', async e => {
                const link = e.target.closest?.('#tabela .filters a');
                if (!link || e.ctrlKey || e.metaKey || e.shiftKey) return;
                e.preventDefault();
                const y = scrollY;
                history.pushState(null, '', link.href);
                try {
                    await Live.refresh();
                    scrollTo({ top: y, behavior: 'instant' });
                } catch {
                    location.href = link.href;  // fall back to a normal page load
                }
            });
            addEventListener('popstate', () => Live.refresh().catch(() => location.reload()));

            // Row buttons do reload the page: come back to the same place, without the smooth scroll
            // (which phones interrupt while the page is still loading).
            const scrollKey = 'admin-scroll';
            const rememberScroll = () => { try { sessionStorage.setItem(scrollKey, String(scrollY)); } catch { } };
            try {
                const y = sessionStorage.getItem(scrollKey);
                sessionStorage.removeItem(scrollKey);
                if (y !== null && !location.hash) {
                    const restore = () => scrollTo({ top: Number(y), behavior: 'instant' });
                    restore();
                    addEventListener('load', restore, { once: true });  // again once images and fonts are in
                }
            } catch { }

            document.addEventListener('submit', e => {
                const form = e.target;
                queueMicrotask(() => { if (!e.defaultPrevented && form.closest('#tabela')) rememberScroll(); });
                if (form.matches('#children-grid .confirm-form')) {
                    const id = form.closest('tr').dataset.id;
                    if (!confirm(`Confirmar pelo padrinho da criança nº ${id}? Todas as crianças pendentes dele passam para Aprovado e ele recebe as instruções de entrega.`))
                        e.preventDefault();
                } else if (form.matches('#children-grid .delete-form')) {
                    const name = form.closest('tr').querySelector(`td[data-col="${NAME_COL}"]`)?.textContent.trim();
                    const id = form.closest('tr').dataset.id;
                    if (!confirm(`Excluir a criança nº ${id}${name ? ` (${name})` : ''}? A linha será apagada da planilha.`))
                        e.preventDefault();
                }
            });

            Live.start({
                // Never swap the table out from under someone typing, choosing a status or saving.
                canSwap: () => saving === 0 && !document.getElementById('live-children').contains(document.activeElement),
                afterSwap: () => { stamp.textContent = `Atualizado automaticamente às ${now()}`; },
            });

            // After "Adicionar criança": highlight the new row and put the cursor in its name.
            const focusId = new URLSearchParams(location.search).get('focus');
            if (focusId) {
                const tr = document.getElementById(`row-${focusId}`);
                if (tr) {
                    tr.classList.add('just-added');
                    tr.querySelector(`td[data-col="${NAME_COL}"]`)?.focus();
                }
                history.replaceState(null, '', location.pathname);
            }
        })();
    </script>
}
